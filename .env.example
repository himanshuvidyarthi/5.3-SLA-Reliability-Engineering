# Copy this file to .env and fill in real values as needed.
# Nothing here is required to run the verifications or the local dashboard —
# every check and every dashboard action runs against the in-memory Fake*
# simulators, never a live API. .env is only consulted, never required.

# Only needed if you swap FakeEpochAgent for a real Gemini-backed agent.
GEMINI_API_KEY=

# Overrides the HMAC signing secret used to mint/verify JWTs in epoch_auth.py.
# Falls back to a teaching placeholder if unset — replace before any real
# deployment, since anyone who reads the source currently knows the default.
JWT_SECRET=
